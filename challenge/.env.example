# ── 저장소 (비우면 메모리 모드: 서버 재시작 시 전부 사라짐. 로컬 개발용) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 로그인 세션 서명 키 (아무 긴 문자열. 배포 전 꼭 바꾼다) ──
SESSION_SECRET=

# ── 총관리자 '비움' 첫 비밀번호 (기본 4581). 계정이 이미 있으면 무시 ──
ADMIN_PASSWORD=4581

# ── 가입 초대 코드 (비우면 아무나 가입 가능. 톡방 공지로 알려주는 코드) ──
INVITE_CODE=

# ── 알림 (웹 푸시). `npm run vapid` 로 생성 ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── 알림 크론 호출 비밀값 (GitHub Actions / pg_cron 이 /api/cron/remind?key= 로 보냄) ──
CRON_SECRET=
